---
import jakarta from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import {configured,requireEditor,privateHeaders} from '../../lib/blog/server';
import '../../styles/admin.css';
export const prerender=false;
for(const [k,v] of Object.entries(privateHeaders()))Astro.response.headers.set(k,v);
let authenticated=false;try{await requireEditor(Astro);authenticated=true;}catch{}
const authError=Astro.url.searchParams.get('auth_error')==='expired';
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>Painel editorial | Instituto Bicalho</title><link rel="icon" href="/assets/favicon.png"/><link rel="preload" href={jakarta} as="font" type="font/woff2" crossorigin/></head><body>
<a class="admin-skip" href="#admin-main">Pular para o conteúdo</a>
<header class="admin-header"><a href="/admin/" aria-label="Painel editorial do Instituto Bicalho"><img src="/assets/logo-transparent-320.webp" width="156" height="45" alt="Instituto Bicalho"/></a><span>Painel editorial</span><a href="/conteudos/" target="_blank" rel="noopener">Ver Blog</a></header>
<main id="admin-main" data-authenticated={authenticated?'true':'false'} data-configured={configured()?'true':'false'}>
{!authenticated?<section class="admin-login"><h1>Entrar no painel</h1><p>Acesso exclusivo para pessoas convidadas.</p>{authError&&<p class="admin-notice" role="alert">Link de acesso inválido ou expirado. Solicite outro.</p>}{!configured()&&<p class="admin-notice">O ambiente de teste está aguardando a conexão com o Supabase da agência.</p>}<form id="login-form"><label>E-mail<input name="email" type="email" autocomplete="username" required/></label><label>Senha<input name="password" type="password" autocomplete="current-password" required/></label><button class="primary" type="submit" disabled={!configured()}>Entrar</button><button type="button" id="recover-password" disabled={!configured()}>Receber link para definir a senha</button></form><p role="status" id="login-status"></p></section>:<div id="editorial-app"><p class="admin-loading">Carregando publicações…</p></div>}
</main><div class="admin-toast" id="admin-status" role="status" aria-live="polite"></div>
<dialog id="admin-dialog" aria-label="Configurações editoriais"><form method="dialog"><button class="dialog-close" aria-label="Fechar" value="close">×</button></form><div id="admin-dialog-content"></div></dialog>
<script src="../../scripts/admin.ts"></script>
</body></html>
