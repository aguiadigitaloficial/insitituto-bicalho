---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import BlogPhoto from '../../components/blog/BlogPhoto.astro';
import BookingLink from '../../components/BookingLink.astro';
import {publicData,publicDb,publicCache,assetUrl,demoEnabled,db,requireEditor,privateHeaders,readAll} from '../../lib/blog/server';
import {renderDocument} from '../../lib/blog/render';
import {validateAdvanced,type PublicPost,type Asset} from '../../lib/blog/model';
import {site} from '../../data/content';
import '../../styles/blog.css';
export const prerender=false;
const path=Astro.params.path||'';const segments=path.split('/').filter(Boolean);
let data:Awaited<ReturnType<typeof publicData>>={posts:[],taxonomies:[],assets:[]};let failure=false;let missing=false;let post:PublicPost|undefined;let privatePreview=false;
try{
 data=await publicData();
 if(segments[0]==='previa'){
  await requireEditor(Astro);privatePreview=true;const row=await db().from('blog_posts').select('*').eq('id',segments[1]).is('trashed_at',null).single();if(row.error)missing=true;else{post={id:row.data.id,slug:row.data.draft.slug,snapshot:row.data.draft,first_published_at:new Date().toISOString(),published_at:new Date().toISOString(),is_demo:row.data.is_demo};const ids=await db().from('blog_media').select('*');data.assets=ids.data||[];}
 }else if(segments.length===1&&!['busca','categoria','tag','autor'].includes(segments[0])){
  post=data.posts.find(p=>p.slug===segments[0]);if(!post){const redirect=await db().from('blog_redirects').select('post_id').eq('slug',segments[0]).maybeSingle();if(redirect.error)throw new Error('Redirecionamento indisponível.');const current=data.posts.find(p=>p.id===redirect.data?.post_id);if(current)return Astro.redirect(`/conteudos/${current.slug}/`,301);missing=true;}
 }
}catch(error){if(segments[0]==='previa')return new Response(null,{status:303,headers:{...privateHeaders(),Location:'/admin/'}});failure=true;Astro.response.status=503;}
if(missing)Astro.response.status=404;
for(const [k,v] of Object.entries(privatePreview?privateHeaders():failure||missing?{'Cache-Control':'no-store'}:publicCache()))Astro.response.headers.set(k,v);
const {posts,taxonomies,assets}=data;const categories=taxonomies.filter(t=>t.kind==='category');
const group=segments.length===2?taxonomies.find(t=>t.slug===segments[1]&&t.kind===({categoria:'category',tag:'tag',autor:'author'} as Record<string,string>)[segments[0]]):undefined;
if(segments.length>0&&!post&&!failure&&!missing&&segments[0]!=='busca'&&!group){missing=true;Astro.response.status=404;}
const query=(Astro.url.searchParams.get('q')||'').slice(0,200);
let filtered=group?posts.filter(p=>group.kind==='author'?p.snapshot.authorId===group.id:(group.kind==='category'?p.snapshot.categoryIds:p.snapshot.tagIds).includes(group.id)):posts;
if(segments[0]==='busca'){if(!query)filtered=[];else try{const found=await readAll<PublicPost>(()=>publicDb().rpc('blog_search',{q:query}));filtered=found.filter(p=>demoEnabled()||!p.is_demo);}catch{failure=true;Astro.response.status=503;Astro.response.headers.set('Cache-Control','no-store');}}
const page=Math.max(1,parseInt(Astro.url.searchParams.get('pagina')||'1')||1),totalPages=Math.ceil(filtered.length/12);const pagePosts=filtered.slice((page-1)*12,page*12);
if(totalPages&&page>totalPages){missing=true;Astro.response.status=404;}
const featured=posts.filter(p=>p.snapshot.featured).slice(0,5);
const s=post?.snapshot;const articleAssets=post?.media||assets;const author=taxonomies.find(t=>t.id===s?.authorId);const cover=articleAssets.find(a=>a.id===s?.coverId);const og=articleAssets.find(a=>a.id===(s?.social.imageId||s?.coverId));const twitter=articleAssets.find(a=>a.id===(s?.social.twitterImageId||s?.social.imageId||s?.coverId));
const ogVariant=og?.variants.filter(v=>v.format==='webp').sort((a,b)=>a.width-b.width).find(v=>v.width>=1600)||og?.variants.filter(v=>v.format==='webp').at(-1);
const urlFor=(a:Asset,w=1600)=>privatePreview?`/api/blog/media-file/?id=${a.id}`:assetUrl(a,w);
const rendered=s?renderDocument(s.content,articleAssets,urlFor):{html:'',toc:[]};
const related=post?(s!.relatedIds.length?s!.relatedIds.map(id=>posts.find(p=>p.id===id)).filter(Boolean) as PublicPost[]:posts.filter(p=>p.id!==post.id&&p.snapshot.categoryIds.includes(s!.primaryCategoryId)).slice(0,3)):[];
const title=failure?'Blog temporariamente indisponível':missing?'Conteúdo não encontrado':s?.seo.title||s?.title||group?.name||(segments[0]==='busca'?'Buscar no Blog':'Blog');
const description=s?.seo.description||s?.excerpt||group?.description||'Conteúdos do Instituto Bicalho Odontologia de Precisão.';
const canonical=new URL(`/conteudos/${post?.slug||''}/`.replace(/\/+/g,'/'),site.url).href;
const articleSchema=post&&s?[{'@type':'BlogPosting','@id':`${canonical}#article`,headline:s.title,description,datePublished:post.first_published_at,dateModified:post.published_at,mainEntityOfPage:canonical,inLanguage:'pt-BR',author:author?{'@type':author.slug==='instituto-bicalho'?'Organization':'Person',name:author.name,url:new URL(`/conteudos/autor/${author.slug}/`,site.url).href}:undefined,publisher:{'@id':`${site.url}/#organization`},image:cover?{'@type':'ImageObject',contentUrl:assetUrl(cover),caption:cover.caption,description:cover.alt,creditText:cover.credit,copyrightNotice:cover.copyright}:undefined},...validateAdvanced(s)]:[];
const canonicalPath=!post&&page>1?`${Astro.url.pathname}?pagina=${page}`:undefined;
---
<Layout title={title} description={description} canonicalPath={canonicalPath} noindex={failure||missing||privatePreview||!!post?.is_demo||segments[0]==='busca'||segments[0]==='tag'||!!s&&!s.seo.index} blogMeta={s?{article:true,title:s.social.title||s.seo.title||s.title,description:s.social.description||description,image:og?urlFor(og):undefined,alt:s.social.alt||og?.alt,width:ogVariant?.width,height:ogVariant?.height,credit:og?.credit,copyright:og?.copyright,twitterTitle:s.social.twitterTitle||s.social.title||s.seo.title||s.title,twitterDescription:s.social.twitterDescription||s.social.description||description,twitterImage:twitter?urlFor(twitter):undefined,twitterAlt:s.social.twitterAlt||s.social.alt||twitter?.alt,robots:[s.seo.nofollow?'nofollow':'',s.seo.noimageindex?'noimageindex':'',s.seo.nosnippet?'nosnippet':''],schema:articleSchema,extraMeta:s.extraMeta}:undefined}>
{failure||missing?<section class="section container blog-message"><h1>{title}</h1><p>{failure?'Não foi possível carregar os conteúdos agora. Tente novamente em instantes.':'Este endereço não está disponível.'}</p><a class="button" href="/conteudos/">Voltar ao Blog</a></section>:post&&s?<>
 {privatePreview&&<div class="blog-preview-note">Prévia privada do rascunho. <a href="/admin/">Voltar ao editor</a></div>}
 <header class="container article-opening section"><div><a class="text-link" href="/conteudos/">Blog</a>{post.is_demo&&<span class="demo-label">Demonstração</span>}<h1 class="blog-full-title">{s.title}</h1><p class="article-byline">{author&&<a href={`/conteudos/autor/${author.slug}/`}>{author.name}</a>}<br/><time datetime={post.first_published_at}>{new Date(post.first_published_at).toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo',dateStyle:'long'})}</time></p>{post.published_at!==post.first_published_at&&<p class="article-updated">Atualizado em {new Date(post.published_at).toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo'})}</p>}</div>{s.showCover&&cover&&<figure>{privatePreview?<img class="blog-private-photo" src={urlFor(cover)} alt={cover.alt}/>:<BlogPhoto asset={cover} priority/>}{cover.caption&&<figcaption>{cover.caption}</figcaption>}</figure>}</header>
 <div class="container article-layout"><article class="article-body">{rendered.toc.length>0&&<nav class="article-index" aria-label="Neste artigo"><h2>Neste artigo</h2><ol>{rendered.toc.map(t=><li class:list={{sub:t.level===3}}><a href={`#${t.id}`}>{t.text}</a></li>)}</ol></nav>}<div class="article-prose" set:html={rendered.html}/><div class="article-tags">{s.tagIds.map(id=>taxonomies.find(t=>t.id===id)).filter(Boolean).map(t=><a href={`/conteudos/tag/${t!.slug}/`}>{t!.name}</a>)}</div><nav class="article-share" aria-label="Compartilhar artigo"><a href={`https://wa.me/?text=${encodeURIComponent(`${s.title} ${canonical}`)}`} target="_blank" rel="noopener noreferrer">WhatsApp</a><a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener noreferrer">Facebook</a><button type="button" data-copy-article>Copiar link</button><span role="status" data-copy-status></span></nav></article><aside class="article-sidebar"><form action="/conteudos/busca/" class="blog-search"><label for="article-search">Buscar no Blog</label><input id="article-search" name="q" type="search" placeholder="O que você procura?"/><button class="button" type="submit">Buscar</button></form>{related.length>0&&<div><h2>Leia também</h2>{related.map(p=><PostCard post={p} assets={assets} taxonomies={taxonomies} compact/>)}</div>}<div class="blog-booking"><h2>Agende sua avaliação</h2><BookingLink label="Agendar avaliação" position="blog"/></div></aside></div>
 </>:<>
 <section class="section blog-opening"><div class="container"><div><a href="/" class="text-link">Instituto Bicalho</a><h1 class="blog-full-title">{group?.name||(segments[0]==='busca'?'Buscar no Blog':'Blog')}</h1><p>{group?.description||'Conteúdos do Instituto Bicalho Odontologia de Precisão.'}</p></div><form action="/conteudos/busca/" class="blog-search"><label for="blog-search">Buscar conteúdos</label><div><input id="blog-search" type="search" name="q" value={query} placeholder="O que você procura?" maxlength="200"/><button class="button" type="submit">Buscar</button></div></form></div></section>
 {segments.length===0&&page===1&&featured.length>0&&<section class="section container"><h2>Em destaque</h2><div class="blog-featured"><PostCard post={featured[0]} assets={assets} taxonomies={taxonomies} lead/><div>{featured.slice(1).map(p=><PostCard post={p} assets={assets} taxonomies={taxonomies} compact/>)}</div></div></section>}
 {segments.length===0&&page===1&&posts.length>0&&<section class="section container"><h2>Publicações recentes</h2><div class="post-grid">{posts.slice(0,3).map(p=><PostCard post={p} assets={assets} taxonomies={taxonomies}/>)}</div></section>}
 {segments.length===0&&page===1&&categories.filter(c=>posts.some(p=>p.snapshot.categoryIds.includes(c.id))).map(c=><section class="section container category-section"><div class="blog-section-heading"><h2>{c.name}</h2><a class="text-link" href={`/conteudos/categoria/${c.slug}/`}>Ver todos</a><div class="category-controls"><button type="button" data-carousel="-1" aria-label={`Publicações anteriores de ${c.name}`}>←</button><button type="button" data-carousel="1" aria-label={`Próximas publicações de ${c.name}`}>→</button></div></div><div class="category-rail">{posts.filter(p=>p.snapshot.categoryIds.includes(c.id)).slice(0,9).map(p=><PostCard post={p} assets={assets} taxonomies={taxonomies}/>)}</div></section>)}
 <section class="section container"><h2>{segments[0]==='busca'?query?`Resultados para “${query}”`:'Digite um termo na busca':group?'Publicações':'Todas as publicações'}</h2>{pagePosts.length?<div class="post-grid">{pagePosts.map(p=><PostCard post={p} assets={assets} taxonomies={taxonomies}/>)}</div>:<p class="blog-empty">{segments[0]==='busca'?'Nenhuma publicação encontrada.':'Novos conteúdos serão publicados aqui.'}</p>}{totalPages>1&&<nav class="blog-pagination" aria-label="Paginação">{Array.from({length:totalPages},(_,i)=><a href={`?${new URLSearchParams({...(query?{q:query}:{}),pagina:String(i+1)})}`} aria-current={page===i+1?'page':undefined}>{i+1}</a>)}</nav>}</section>
 </>}
</Layout>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-carousel]').forEach(button=>button.addEventListener('click',()=>{const rail=button.closest('.category-section')?.querySelector('.category-rail');rail?.scrollBy({left:(rail.clientWidth||300)*Number(button.dataset.carousel),behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});}));
document.querySelector('[data-copy-article]')?.addEventListener('click',async()=>{const status=document.querySelector('[data-copy-status]');try{await navigator.clipboard.writeText(location.href);if(status)status.textContent='Link copiado.';}catch{if(status)status.textContent='Copie o endereço na barra do navegador.';}});
</script>
