---
import Text from '../components/TypographyText.astro';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import BookingLink from '../components/BookingLink.astro';
import Precision from '../components/Precision.astro';
import Faq from '../components/Faq.astro';
import Units from '../components/Units.astro';
import TeamPerson from '../components/TeamPerson.astro';
import { areas, team, homeQuestions } from '../data/content';
import { photoSizes } from '../data/photos';
const photos = ['careOverview', 'smile', 'aligners', 'precision'] as const;
const portraitTeam = team.filter(person => person.photo).sort((a,b) => a.portraitOrder! - b.portraitOrder!);
const otherTeam = team.filter(person => !person.photo);
---
<Layout title="Instituto Bicalho | Clínica Odontológica de Precisão" appendBrand={false} description="Clínica odontológica em João Monlevade e Belo Horizonte. Equipe multidisciplinar de dentistas, planejamento individualizado e tecnologia digital do diagnóstico ao tratamento.">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-layout">
      <div class="hero-copy">
        <span class="hero-eyebrow">Odontologia de Precisão</span>
        <h1 id="hero-heading"><Text keepEnd={false} text="Clínica odontológica "/><br/><span><Text keepEnd={false} text="em João Monlevade e Belo Horizonte."/></span></h1>
        <p><Text text="Planejamento individualizado, equipe multidisciplinar de dentistas e tecnologia digital do diagnóstico ao resultado."/></p>
        <div class="hero-actions"><BookingLink position="hero" id="primary-booking"/><a class="text-link" href="#instituto">Conheça o Instituto</a></div>
        <span class="hero-location"><Icon name="pin" size={18}/>João Monlevade e Belo Horizonte</span>
      </div>
      <div class="hero-visual glass">
        <Photo name="hero" class="hero-photo" eager sizes={photoSizes.hero}/>
        <div class="hero-image-base">
          <div class="photo-tags" aria-hidden="true"><span>Escuta</span><span>Cuidado</span><span>Tecnologia</span></div>
          <div class="hero-glass"><img class="hero-care-symbol" src="/assets/logo-transparent-600.webp" width="32" height="32" alt="" aria-hidden="true"/><div><strong>Você no centro do cuidado.</strong><p><Text text="Da primeira conversa a cada novo sorriso."/></p></div></div>
        </div>
      </div>
    </div>
    <div class="container hero-footnote"><span>Saúde, função e estética. Juntas.</span><a href="#instituto">Explore o Instituto</a></div>
  </section>
  <section class="section institution" id="instituto" aria-labelledby="institution-heading">
    <div class="container">
      <div class="institution-layout">
        <div class="institution-copy"><span class="eyebrow">Instituto Bicalho Odontologia de Precisão</span><h2 id="institution-heading"><Text keepEnd={false} text="Uma equipe, "/><span><Text text="várias especialidades."/></span></h2><p class="lead-copy"><Text text="Avaliação individualizada antes de qualquer tratamento."/></p><p><Text text="A equipe reúne implantodontia, ortodontia, odontopediatria, prótese dentária, endodontia, periodontia e harmonização orofacial, com planejamento conjunto quando o caso exige mais de uma especialidade."/></p><p><Text text="O acompanhamento começa pela queixa e pelo histórico do paciente, segue para o exame clínico e, quando indicado, para o planejamento digital antes de qualquer procedimento."/></p></div>
        <div class="partner-photos glass"><Photo name="partnersTogether" sizes={photoSizes.partnersTogether}/><div class="portrait-note"><img src="/assets/logo-transparent-600.webp" width="28" height="28" alt="" aria-hidden="true"/><span><Text text="Dr. Bruno Bicalho e Dra. Roberta Souza Carneiro, sócios do Instituto Bicalho."/></span></div></div>
      </div>
      <div id="equipe">
        <details class="team-panel" id="equipe-completa"><summary><span>Conheça nossa equipe<small>Profissionais e áreas de atuação</small></span><span class="round-arrow"><Icon name="plus" size={22}/></span></summary><div class="team-panel-content"><Photo name="team" class="team-photo" sizes="(min-width: 1000px) 880px, 100vw"/><div class="team-grid team-portraits">{portraitTeam.map(person => <TeamPerson person={person}/>)}</div><div class="team-grid team-roster">{otherTeam.map(person => <TeamPerson person={person}/>)}</div></div></details>
      </div>
    </div>
  </section>
  <section class="section areas" aria-labelledby="areas-heading"><div class="container">
    <div class="section-intro"><div><span class="eyebrow">Nossas áreas de cuidado</span><h2 id="areas-heading"><Text keepEnd={false} text="Quatro áreas, "/><br/><span><Text keepEnd={false} text="um só planejamento."/></span></h2></div><p><Text text="Tratamentos, estética, ortodontia e cirurgia, e odontologia de precisão, detalhados a seguir."/></p></div>
    <div class="area-grid">{areas.map((area, i) => <a class={`area-card area-card-${i+1}`} href={`/${area.slug}/`}><Photo name={photos[i]} class="area-photo" sizes={photoSizes.area[i]}/><span class="area-number" aria-hidden="true">0{i+1}</span><div class="area-card-copy glass"><div class="area-card-title"><h3><Text keepEnd={false} text={area.title}/></h3></div><p><Text text={area.homeSummary ?? area.short}/></p><div class="area-link-row"><span class="area-link">Explorar cuidados</span><span class="round-arrow"><Icon name="arrow" size={21}/></span></div></div></a>)}</div>
  </div></section>
  <Precision/>
  <Faq questions={homeQuestions}/>
  <Units heading={['Duas unidades,', 'um só padrão de cuidado.']}/>
</Layout>
