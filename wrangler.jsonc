{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instituto-bicalho-blog-preview",
  "account_id": "7803c3e071f890d75cda7f82cc8b1f54",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "images": {"binding": "IMAGES"},
  "vars": {
    "BLOG_HOST": "cloudflare",
    "BLOG_ENVIRONMENT": "preview",
    "BLOG_DEMO": "true",
    "PUBLIC_INDEXABLE": "false",
    "PUBLIC_SITE_URL": "https://institutobicalho.com"
  },
  "observability": {"enabled": true},
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/admin", "/admin/*", "/api/*", "/conteudos", "/conteudos/*", "/sitemap.xml"]
  }
}
