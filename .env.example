# Keep previews out of search. Enable only for the approved production release.
PUBLIC_INDEXABLE=false
PUBLIC_SITE_URL=https://institutobicalho.com
# Optional; no analytics request is made without a valid ID and consent.
PUBLIC_GA_ID=
PUBLIC_GOOGLE_VERIFICATION=

# Server-only editorial environment. Never use PUBLIC_ prefixes for these keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BLOG_CRON_SECRET=
# Enable only in the isolated test preview. Production always excludes demos.
BLOG_DEMO=false
# Used by the one-time demonstration seed, not by the public website.
BLOG_SEED_ACTOR=
